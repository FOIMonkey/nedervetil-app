#!/bin/bash

export RUBYOPT="-W0"

LOC="`dirname "${BASH_SOURCE[0]}"`"/..
cd "$LOC"

# Specific file if specified
if [ -n "${1:-}" ]
then
    case "$1" in
      /*) f="$1" ;;
       *) f="$(pwd)/$1" ;;
    esac
    bundle exec rails runner 'MailServerLog.load_file(ARGV.fetch(0))' -- "$f"
    exit
fi

# Load in last three days worth of logs (if they've been modified)
# Stop if the setting can't be read or is blank: ls with no pattern lists
# this directory, and its last three entries were loaded as mail logs.
LOG_PATH=$(bin/config MTA_LOG_PATH) || exit 1
if [ -z "$LOG_PATH" ]
then
    echo "MTA_LOG_PATH is blank" >&2
    exit 1
fi
shopt -s nullglob
# Intentional unquoted expansion of the configured glob pattern into an array.
MATCHES=( $LOG_PATH )
if [ "${#MATCHES[@]}" -eq 0 ]
then
    exit 0
fi
while IFS= read -r -d '' X
do
    bundle exec rails runner 'MailServerLog.load_file(ARGV.fetch(0))' -- "$X"
done < <(printf '%s\0' "${MATCHES[@]}" | sort -z | tail -z -n 3)

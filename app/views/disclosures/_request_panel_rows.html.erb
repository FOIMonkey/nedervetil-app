<ul class="documents-panel__files">
  <% rows.each do |row| %>
    <% suggestion = row.suggestion %>
    <li class="documents-panel__file">
      <span class="documents-panel__name">
        <% if row.email_text %><%= _('The email') %><% else %><%= link_to row.name, "#attachment-#{row.attachment.id}" %><% end %>
      </span>
      <% if suggestion.suggestion == 'none' %>
        <span class="documents-panel__suggestion"><%= suggestion.reason %></span>
      <% else %>
        <span class="documents-panel__suggestion"><strong><%= suggestion.label %></strong>: <%= suggestion.reason %></span>
      <% end %>
      <% if row.document %>
        <span class="documents-panel__made"><%= _('Document: {{document}} ({{state}})', document: link_to(row.document.title, disclosure_document_path(row.document)), state: document_state(row.document).downcase) %></span>
      <% elsif suggestion.suggestion != 'none' && (can?(:create_document, row.attachment) || can?(:request_document_review, row.attachment)) %>
        <% make_directly = can?(:create_document, row.attachment) %>
        <%# data-turbo="false": making it ends on an admin page, which loads in full. %>
        <%= form_tag make_directly ? disclosure_documents_path : disclosure_request_document_review_path, class: 'documents-panel__make', data: { turbo: false } do %>
          <input type="hidden" name="attachment_id" value="<%= row.attachment.id %>">
          <% if row.email_text %><input type="hidden" name="source" value="email_text"><% end %>
          <% Disclosures::Document::KIND_LABELS.each_key do |kind| %>
            <button type="submit" name="kind" value="<%= kind %>" class="button <%= kind == suggestion.suggestion ? 'documents-panel__primary' : 'documents-panel__plain' %>">
              <%= make_directly ? _('Make {{kind}}', kind: _(Disclosures::Document::KIND_LABELS.fetch(kind)).downcase) : _('Send {{kind}} for admin review', kind: _(Disclosures::Document::KIND_LABELS.fetch(kind)).downcase) %>
            </button>
          <% end %>
        <% end %>
      <% end %>
    </li>
  <% end %>
</ul>

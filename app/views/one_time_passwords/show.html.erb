<% @title = _('Two factor authentication') %>
<%= page_band back: back_to_account %>
<% if current_user.totp? %>
  <p><%= _('Authenticator sign-in is enabled.') %></p>
  <p><%= link_to _('Manage recovery codes'), one_time_password_backup_codes_path %></p>
  <% unless current_user.is_admin? %>
    <h2><%= _('Disable two factor authentication') %></h2>
    <%= form_tag one_time_password_path, method: :delete, data: { turbo: false } do %>
      <%= render 'one_time_passwords/credentials' %>
      <div class="form_button">
        <%= submit_tag _('Disable two factor authentication') %>
      </div>
    <% end %>
  <% end %>
<% else %>
  <%= render 'one_time_passwords/help_guide' %>
  <p><%= link_to _('Enable two factor authentication'), new_one_time_password_path %></p>
<% end %>

<% @title = _('Set up two factor authentication') %>
<%= page_band %>
<%= form_tag start_one_time_password_path, data: { turbo: false } do %>
  <p>
    <%= label_tag :password, _('Current password'), class: 'form_label' %>
    <%= password_field_tag :password, nil, required: true, autocomplete: 'current-password' %>
  </p>
  <div class="form_button">
    <%= submit_tag _('Continue') %>
  </div>
<% end %>

<% @title = _('Recovery codes') %>
<%= page_band back: back_to_account %>
<p><%= _('%d codes remain. Generating a new set replaces all previous codes.') % current_user.otp_backup_codes.size %></p>
<%= form_tag one_time_password_backup_codes_path, data: { turbo: false } do %>
  <%= render 'one_time_passwords/credentials' %>
  <div class="form_button">
    <%= submit_tag _('Generate new recovery codes') %>
  </div>
<% end %>

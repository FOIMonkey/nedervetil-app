<p>
  <%= label_tag :password, _('Current password'), class: 'form_label' %>
  <%= password_field_tag :password, nil, required: true, autocomplete: 'current-password' %>
</p>
<p>
  <%= label_tag :otp_code, _('Authenticator code or recovery code'), class: 'form_label' %>
  <%= text_field_tag :otp_code, nil, required: true, autocomplete: 'one-time-code' %>
</p>

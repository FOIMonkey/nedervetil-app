<% @title = _('Set up two factor authentication') %>
<%= page_band %>
<p><%= _('Add this account to your authenticator app, then enter its code. This setup expires after five minutes.') %></p>
<p><%= otp_provisioning_qr_code(ROTP::TOTP.new(@enrolment.secret, issuer: AlaveteliConfiguration.site_name).provisioning_uri(@enrolment.user.email)) %></p>
<p><%= _('Or enter this secret manually:') %> <code><%= @enrolment.secret %></code></p>
<%= form_tag one_time_password_path, data: { turbo: false } do %>
  <p>
    <%= label_tag :otp_code, _('Authenticator code'), class: 'form_label' %>
    <%= text_field_tag :otp_code, nil, required: true, autocomplete: 'one-time-code' %>
  </p>
  <div class="form_button">
    <%= submit_tag _('Enable two factor authentication') %>
  </div>
<% end %>

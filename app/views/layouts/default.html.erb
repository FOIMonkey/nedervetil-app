<!DOCTYPE html>
<html lang="<%= AlaveteliLocalization.html_lang %>" class="no-js">
  <head>
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <% unless @render_to_file %>
      <%# Turbo Drive (doc/FORK.md): the response's nonce, which Turbo and
          helpers/turbo_script_guard.js read; no fetching pages a pointer rests
          on; and a page on the opt-out list (TurboDrive) always loads in full. %>
      <%= csp_meta_tag %>
      <meta name="turbo-prefetch" content="false">
      <% if turbo_visit_reload? %>
        <meta name="turbo-visit-control" content="reload">
      <% end %>
      <%# Turbo keeps no copy of a page rendered for someone signed in, so Back
          asks the server again: signing out in another tab, or losing access,
          leaves nothing private to show from Turbo's history. Nor of a page
          that shows a visitor something private (keep_no_turbo_copy!). %>
      <% if current_user || keep_no_turbo_copy? %>
        <meta name="turbo-cache-control" content="no-cache">
      <% end %>
    <% end %>

    <title>
      <% if @title %>
        <%=@title%> - <%= site_name %>
      <% else %>
        <%= site_name %> - <%= _('Make and browse Freedom of Information (FOI) requests') %>
      <% end %>
    </title>

    <%= render :partial => 'layouts/favicon' %>

    <%= render :partial => 'general/stylesheet_includes' %>
    <% if is_admin? %>
      <%= render :partial => 'general/admin_stylesheet' %>
    <% end %>

    <% if @no_crawl %>
      <meta name="robots" content="noindex, nofollow">
    <% end %>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%= render :partial => 'general/opengraph_tags' %>
    <%= render :partial => 'general/before_head_end' %>
    <!-- Replace the html tag's no-js class with js -->
    <%= javascript_tag nonce: true do %>
      (function(H){
        H.className = H.className.replace(/\bno-js\b/,'js-loaded')
      })(document.documentElement);
    <% end %>
    <%# Stimulus on every page. The three controllers on the body do what
        jQuery UJS did for data-confirm, data-method and data-disable-with. %>
    <%= javascript_importmap_tags("public") unless @render_to_file %>
    <%= content_for :javascript_head %>
  </head>
  <body class="<%= yield :body_class -%> <% if @in_pro_area %>alaveteli-pro<% end %>" <% unless turbo_drive? || @render_to_file %>data-turbo="false" <% end %>data-controller="confirm method-link form-lock" data-action="click->confirm#click submit->confirm#submit click->method-link#follow submit->form-lock#lock">
    <% unless @render_to_file %>
      <%# Each Turbo Drive visit's title is read out here (public/helpers/
          page_announcer). Hidden inline, as not every theme's stylesheet has
          a visually-hidden class. %>
      <div id="page-announcer" aria-live="polite" aria-atomic="true" data-turbo-permanent
           style="position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0"></div>
    <% end %>
    <% if is_admin? %>
      <%= render :partial => 'admin/general/admin_navbar' %>
    <% end %>
    <div class="entirebody">

      <nav aria-label="Skip navigation bar">
        <a href="#content" class="show-with-keyboard-focus-only skip-to-link" tabindex="0">Skip to content</a>
      </nav>

      <% unless @render_to_file %>
      <!-- begin popups -->
        <%= render 'general/site_wide_announcement' if site_wide_announcement.present? %>
      <!-- end popups -->
      <% end %>

      <%= render :partial => 'general/responsive_header' %>

      <div id="wrapper">
        <div id="content" role="main">
          <%# The page is rendered first, so a band in it has already placed
              the notice after itself (ApplicationHelper#band_notice). %>
          <% page = yield(:layout) %>
          <%= page_flashes unless band_notice_placed? %>

          <div id="<%= controller.controller_name + "_" + controller.action_name %>" class="controller_<%= controller.controller_name %>">
            <%= page %>
          </div>
          <div style="clear:both"></div>
        </div>
      </div>

      <nav aria-label="Skip footer">
        <a href="#content" class="show-with-keyboard-focus-only skip-to-link">
          <%= _('Back to content') %>
        </a>
      </nav>

      <%= render :partial => 'general/responsive_footer' %>
    </div>

    <% unless @render_to_file %>
      <%# The role, not a permission: an admin's own visits aren't counted. %>
      <%= render partial: 'ga_code' unless @user&.is_admin? %>

      <% if AlaveteliConfiguration::force_registration_on_new_request && !@user %>
        <%# "Make request" opens the sign-in form here (signin-dialog). %>
        <dialog class="signin-dialog" aria-label="<%= _('Sign in') %>" data-controller="signin-dialog" data-signin-dialog-src-value="<%= signin_path(modal: 1, r: select_authority_path) %>" data-signin-dialog-next-value="<%= select_authority_url %>" data-signin-dialog-trigger-value="#make-request-link" data-action="close->signin-dialog#closed">
          <button type="button" class="signin-dialog__close" data-action="signin-dialog#close" aria-label="<%= _('Close') %>">&times;</button>
          <iframe class="signin-dialog__frame" title="<%= _('Sign in') %>" src="about:blank" data-signin-dialog-target="frame"></iframe>
        </dialog>
      <% end %>

      <%= content_for :javascript %>
    <% end %>

    <%= render :partial => 'general/before_body_end' %>

  </body>
</html>

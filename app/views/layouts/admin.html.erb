<!DOCTYPE html>
<html lang="en-gb">
  <head>
    <meta http-equiv="content-type" content="text/html;charset=UTF-8" >
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="turbo-prefetch" content="false">

    <title>
      <%= @title ? "#{ @title } -" : "" %> <%= site_name %> admin
    </title>

    <%= stylesheet_link_tag "admin", :title => "Main", :rel => "stylesheet" %>
    <%= stylesheet_link_tag 'admin/print', :rel => "stylesheet", :media => "print"  %>

    <%= javascript_include_tag "trix", nonce: true %>

    <%= render :partial => 'layouts/favicon' %>
    <%# Stimulus on every admin page, plus Turbo Frames (with Turbo Drive off).
        The first three controllers on the body do what jQuery UJS did for
        data-confirm, data-method and data-disable-with; admin-jump opens the
        global jump dialog. %>
    <%= javascript_importmap_tags("admin", importmap: Rails.application.admin_importmap) %>
    <%= content_for :javascript_head %>
  </head>
  <body class="admin" data-controller="confirm method-link form-lock admin-jump" data-admin-jump-url-value="<%= admin_jump_path %>" data-action="click->confirm#click submit->confirm#submit click->method-link#follow submit->form-lock#lock keydown@document->admin-jump#shortcut">
    <%= render :partial => 'admin/general/admin_navbar' %>
    <%= render :partial => 'admin/general/admin_subnav' %>
    <div id="main" class="container">
      <% if flash[:error] %>
        <div class="alert alert-error" role="alert">
          <%= render_flash(flash[:error]) %>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="alert alert-info" role="status">
          <%= render_flash(flash[:notice]) %>
        </div>
      <% end %>

      <%= yield  %>
    </div>

    <footer class="admin-footer">
      <div class="container">
        <ul class="nav nav-pills">
          <li>
            <a href="https://alaveteli.org/docs/running/admin_manual/">
              Admin Manual
            </a>
          </li>
          <li>
            <%= link_to 'Changelog', admin_changelog_index_path %>
          </li>
          <li>
            <a href="https://alaveteli.org/community/">
              Alaveteli Community
            </a>
          </li>
          <li>
            <a href="https://tictec.mysociety.org/ati-community-of-practice/">
              Knowledge Hub
            </a>
          </li>
        </ul>
      </div>
    </footer>
    <%= render :partial => 'admin/general/jump_dialog' %>
  </body>
</html>

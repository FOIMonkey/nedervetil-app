<!DOCTYPE html>
<html lang="<%= AlaveteliLocalization.html_lang %>">
  <head>
    <meta charset="utf-8">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <title>
      <% if @title %>
        <%=@title%> - <%= site_name %>
      <% else %>
        <%= site_name %> - <%= _('Make and browse Freedom of Information (FOI) requests') %>
      <% end %>
    </title>

    <%= render :partial => 'general/responsive_stylesheets' %>
    <%= render :partial => 'layouts/favicon' %>
    <%= javascript_importmap_tags("public") %>
  </head>
  <body data-turbo="false" data-controller="confirm method-link form-lock" data-action="click->confirm#click submit->confirm#submit click->method-link#follow submit->form-lock#lock">
    <div class="entirebody">
      <div id="content">
        <% if flash[:notice] %>
          <div id="notice"><%= render_flash(flash[:notice]) %></div>
        <% end %>
        <% if flash[:error] %>
          <div id="error"><%= render_flash(flash[:error]) %></div>
        <% end %>

        <div id="<%= controller.controller_name + "_" + controller.action_name %>" class="controller_<%= controller.controller_name %>">
          <%= yield :layout %>
        </div>
      </div>
    </div>
  </body>
</html>

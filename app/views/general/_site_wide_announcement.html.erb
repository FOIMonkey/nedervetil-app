<div class="popup popup--popup popup--standard" role="alert" id="standard-popup" data-controller="announcement-dismiss">
  <div class="row">
    <div class="popup__content">
      <% if site_wide_announcement.title.present? %><strong><%= site_wide_announcement.title %> - </strong><% end %>
      <%= sanitize_without_style_blocks(site_wide_announcement.content) %>
      <%= button_to announcement_path(site_wide_announcement), method: :delete, class: 'popup__close', form_class: 'popup__close-form', form: { data: { action: 'announcement-dismiss#dismiss' } }, aria: { label: _('Close') } do %>
        <span aria-hidden="true">&times;</span>
      <% end %>
    </div>
  </div>
</div>

<div id="logged_in_bar" class="logged_in_bar account-link-menu-item" data-controller="account-menu" data-action="click@document->account-menu#outside keydown@document->account-menu#escape">
<% if @user %>
  <a href="<%= show_user_profile_path(:url_name => @user.url_name) %>" data-account-menu-target="link" data-action="click->account-menu#toggle keydown->account-menu#key" class="account-link js-account-link">
    <%= @user.name.split.first %>
  </a>
  <div class="logged-in-menu js-account-menu" data-account-menu-target="menu">
    <div class="profile-summary">

        <span class="profile-summary__name"><%= @user.name %>
        </span>
        <br/>
        <span class="profile-summary__email"><%= @user.email %></span>

    </div>
    <ul class="logged-in-menu__links">
      <%= render :partial => 'alaveteli_pro/general/log_in_bar_links' %>
      <li class="logged-in-menu__signout-link">
        <%# No return path: signing out goes to the home page (Users::SessionsController#destroy). %>
        <%= link_to _("Sign out"), signout_path, method: :delete, data: { turbo: false } %>
      </li>
    </ul>
    </div>
<% else %>
  <%= link_to _("Sign in or sign up"), signin_path(:r => request.fullpath), :class => "sign_in_link", data: { turbo: false } %>
<% end %>
</div>

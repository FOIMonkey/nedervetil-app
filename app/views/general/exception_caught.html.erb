<%= page_band(@status == 404 ? _("Sorry, we couldn't find that page") : _("Sorry, there was a problem processing this page")) %>
<div id="error-page" class="error-page">
<% if @status == 404 %>
  <p><%= _("The page doesn't exist. Things you can try now:")%></p>

  <ul>
    <li><%= _("Check for mistakes if you typed or copied the address.")%></li>
    <li><%= _("Search the site to find what you were looking for.")%>
    <%= form_tag(disclosure_documents_path, {:method => "get", :id => "search_form"}) do %>
      <%= text_field_tag 'q', params[:q], { :size => 30, :title => "type your search term here" } %>
      <%= submit_tag _("Search") %>
    <% end %>
    </li>
  </ul>

<% else %>
  <p><%= _('You have found a bug.  Please <a href="{{contact_url}}">contact us</a> to tell us about the problem', :contact_url => help_contact_path) %></p>

<% end %>
</div>

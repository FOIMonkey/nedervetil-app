<%- if @render_to_file %>
  <style>
      <%= read_asset_file('responsive/application.css') %>
      <%= read_asset_file('responsive/print.css') %>
  </style>
<%- else %>
  <%= render :partial => 'general/responsive_stylesheets' %>
  <%= stylesheet_link_tag 'responsive/print', :rel => "stylesheet", :media => "print", :data => { :turbo_track => 'reload' } %>
  <% if !params[:print_stylesheet].nil? %>
    <%# dynamic: a Turbo Drive visit adds it, and takes it away again. %>
    <%= stylesheet_link_tag 'responsive/print', :rel => "stylesheet", :media => "all", :data => { :turbo_track => 'dynamic' } %>
  <% end %>
<% end %>

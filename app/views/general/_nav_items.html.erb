<% if @user %>
  <li><%= link_to _('Make request'), make_request_path, id: 'make-request-link' %></li>
<% end %>
<li class="<%= 'selected' if controller?('topics/topics') %>"><%= link_to _('Topics'), topics_path %></li>
<li class="<%= 'selected' if controller?('disclosures/documents', 'disclosures/versions') %>">
  <%= link_to _('Documents'), disclosure_documents_path %>
</li>
<li class="<%= 'selected' if controller?('public_body', 'authority_groups/groups') %>">
  <%= link_to _('Authorities'), authority_groups_path %>
</li>
<li class="<%= 'selected' if controller?('help', 'help_site') %>">
  <% if HelpSite.pack? %>
    <%= link_to _('Help'), help_home_path %>
  <% else %>
    <%= link_to _('About'), help_about_path %>
  <% end %>
</li>

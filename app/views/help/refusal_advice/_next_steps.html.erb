<h2>Next steps</h2>

<ul class="wizard__next-steps">
  <% actions.each do |action| %>
  <li class="wizard__next-step" data-block="<%= action.id %>">
    <a class="wizard__next-step__title" href="#" data-action="refusal-wizard#toggleStep"><%= action.title %></a>
    <%= render action, f: f %>
  </li>
  <% end %>
</ul>

<% param = local_assigns.fetch(:param, 'page') %>
<%# Path only: url_for would take a host from the query string. %>
<% page_link = ->(number) { "#{request.path}?#{request.query_parameters.merge(param => number).to_query}" } %>
<% if items.total_pages > 1 %>
  <nav class="groups-pager" aria-label="<%= _('Pages') %>">
    <% if items.previous_page %>
      <%= link_to _('Previous'), page_link.(items.previous_page), rel: 'prev' %>
    <% end %>
    <% if items.next_page %>
      <%= link_to _('Next'), page_link.(items.next_page), rel: 'next' %>
    <% end %>
  </nav>
<% end %>

<% if IncomingAttention::Labels.visible_to?(incoming_message, @user, current_ability) && @info_request.is_actual_owning_user?(@user) && can?(:update_request_state, @info_request) %>
  <%# Comes back to this page, which refreshes in place and lands on the
      message (doc/FORK.md). %>
  <%= form_tag attention_choice_path(@info_request.url_title), class: 'incoming-attention-choice', data: { turbo_action: 'replace', lands_on: dom_id(incoming_message) } do %>
    <%= hidden_field_tag :incoming_message_id, incoming_message.id, id: nil %>
    <% if IncomingAttention::Effective.routine?(incoming_message) %>
      <%= button_tag _('This needs my attention'), name: 'incoming_attention_choice', value: 'attention', class: 'button-tertiary' %>
    <% else %>
      <%= button_tag _('File as routine'), name: 'incoming_attention_choice', value: 'routine', class: 'button-tertiary' %>
      <span class="receipt__hint"><%= _('Nothing to do here') %></span>
    <% end %>
  <% end %>
<% end %>

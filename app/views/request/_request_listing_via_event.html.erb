<%# A request in a batch, by its sending event. %>
<div class="request_listing">
  <div class="request_left">
    <span class="head">
      <%= link_to event.info_request.title, request_path(event.info_request) %>
    </span>

    <div class="requester">
      <%= event_description(event) %>
    </div>

    <p>
      <i class="icon-standalone icon_<%= event.info_request.calculate_status %>"></i>
      <strong>
        <%= event.info_request.display_status(cached_value_ok=true) %>
      </strong>
    </p>
  </div>

  <div class="request_right">
    <% next_action = can?(:adjust_deadlines, event.info_request) ? Deadlines::NextAction.for(event.info_request) : nil %>
    <% if next_action && !next_action.none? %><p class="request_listing__deadline"><%= render partial: 'deadlines/action_line', locals: { action: next_action } %></p><% end %>
  </div>
</div>

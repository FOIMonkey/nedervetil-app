<% attention_visible = IncomingAttention::Labels.visible_to?(incoming_message, @user, current_ability) %>
<% routine_update = !!(attention_visible && IncomingAttention::Effective.routine?(incoming_message)) %>
<div class="incoming correspondence <%= incoming_message.prominence %> js-collapsible" data-routine-update="<%= routine_update %>" id="<%= dom_id(incoming_message) %>" data-controller="collapsible" data-collapsible-routine-value="<%= routine_update %>" data-action="collapsible:set@window->collapsible#set hashchange@window->collapsible#reveal">
  <%# On the requester's page the feed's row already says who and when. %>
  <% unless @request_history %>
  <div class="correspondence__header" role="heading" aria-level="2" data-collapsible-target="header" data-action="click->collapsible#headerClick mouseover->collapsible#hover mouseout->collapsible#hover">
    <span class="correspondence__header__author js-collapsible-trigger" data-collapsible-target="trigger" data-action="click->collapsible#toggle keydown->collapsible#key mouseover->collapsible#hover mouseout->collapsible#hover"><%= Deadlines::History.sender(@info_request, incoming_message) %></span>

    <%= render partial: 'request/incoming_prediction', locals: { incoming_message: incoming_message } %>

    <%= link_to incoming_message_path(incoming_message, anchor_only: true), :class => 'correspondence__header__date' do %>
      <%= simple_date(incoming_message.sent_at) %>
    <% end %>
    <%= render partial: 'request/attention_choice', locals: { incoming_message: incoming_message } %>
  </div>
  <% end %>

  <% incoming_message.parsed_for_display? if incoming_message.last_parsed.nil? && can?(:read, incoming_message) %>
  <%= render partial: 'request/prominence', locals: { prominenceable: incoming_message } %>

  <%- if can?(:read, incoming_message) %>
    <%= render partial: 'request/incoming_outcome', locals: { incoming_message: incoming_message } unless @request_history %>
    <% if Current.memo(:refusal_identification) { feature_enabled?(:refusal_identification) } %>
      <%= render partial: 'request/incoming_refusals',
                 locals: { incoming_message: incoming_message } %>
    <% end %>

    <div class="correspondence_text">
      <%= render partial: 'request/attachments',
                 locals: { incoming_message: incoming_message } %>
    </div>

    <% if @request_history && @receipt_message != incoming_message %>
      <%= render partial: 'request/attention_choice', locals: { incoming_message: incoming_message } %>
    <% end %>

    <p class="event_actions">
      <% if is_admin? %>
        <%= link_to "Admin", edit_admin_incoming_message_path(incoming_message.id) %>
      <% end %>
    </p>
  <%- end %>
</div>

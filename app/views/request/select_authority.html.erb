<% @title = _("Find an authority")  %>

<%= page_band %>

<div id="authority_selection" class="authority_selection" data-controller="search-ahead" data-search-ahead-url-value="<%= search_ahead_bodies_url %>" data-search-ahead-param-value="query">
  <%# This view is rendered from multiple urls, hence why the form action is blank %>
  <%= form_tag "", { :id => 'search_form', :method => 'get' } do %>
    <div>
      <p>
        <%= _("First, type in the <strong>name of the public authority" \
              "</strong> you'd like information from.") %>
        <% if AlaveteliConfiguration.authority_must_respond %>
          <%= _('<strong>By law, they have to respond</strong> ' \
                  '(<a href="{{url}}">why?</a>).',
                :url => (help_about_path(:anchor => 'whybother_them')).html_safe) %>
        <% end %>
      </p>
      <label for="query" class="visually-hidden"><%=_('Authority name')%></label>
      <%= text_field_tag :query, params[:query], { :size => 30,
                                                   :data => { :search_ahead_target => 'field', :action => 'search-ahead#queue' },
                                                   :title => _('type your search term here'),
                                                   :required => true,
                                                   :placeholder => _('e.g. Ministry of Defence') } %>
      <%= hidden_field_tag :bodies, 1 %>
      <%= submit_tag _('Search') %>
    </div>
  <% end %>

  <%# The results are a Turbo Frame the search-ahead controller points at the
      search; target="_top" opens a result's page rather than loading it into
      the frame. %>
  <%= turbo_frame_tag 'typeahead_response', class: 'typeahead_response', target: '_top', style: 'display: block', aria: { live: 'polite' },
                    data: { search_ahead_target: 'results', action: 'turbo:frame-load->search-ahead#loaded turbo:frame-missing->search-ahead#missing' } do %>
    <%= render :partial => 'public_body/search_ahead' %>
  <% end %>
</div>

<div id="select_authority_help" class="select_authority_help">
  <%= render :partial => 'request/select_authority_help' %>
</div>

<div class="dashboard-right-column">

  <div class="requests">
    <div class="requests__folder-title">
      <h2><%= @request_filter.filter_capital_label %></h2>
      <% attention_active = defined?(IncomingAttention::Effective) && IncomingAttention::Effective.active? %>
      <% if attention_active && @request_filter.filter == 'needs_attention' %>
        <p class="requests__folder-hint"><%= _("Replies you should read. Each one stays here until you set its request's status.") %></p>
      <% elsif attention_active && @request_filter.filter == 'routine_updates' %>
        <p class="requests__folder-hint"><%= _('Acknowledgements and other routine updates. Dismiss an update to remove it from this list.') %></p>
      <% end %>
    </div>
    <div class="requests__header">

      <%= form_for(@request_filter, url: '', method: 'get', html: { class: 'requests__filter_form', data: { controller: 'auto-submit' } }) do |f| %>
        <div class="requests__search">
          <%= f.text_field :search, :placeholder => _('Search') %>
          <button type="submit" class="requests__search__button">
            <span class="visually-hidden">
              <%= _("Submit Search") %>
            </span>
          </button>
        </div>
        <div class="requests__sort">
          <%= f.label :order, _('Sort by') %>
          <%= f.select :order, @request_filter.order_options, {}, data: { action: 'auto-submit#submit' } %>
        </div>
        <%= f.hidden_field :filter %>
      <% end %>

    </div> <!-- .requests-header -->
    <div class="search-and-filter-overview">
      <p>
      <% if @request_filter.search.present? %>
        <%= _("Searching for <strong>{{search_term}}</strong> in <strong>" \
              "{{filter_description}}</strong> sorted by <strong>" \
              "{{order_description}}</strong> <a href=\"{{reset_url}}\"" \
              " class=\"clear-icon\">clear</a>",
              :reset_url => alaveteli_pro_info_requests_path,
              :search_term => @request_filter.search,
              :filter_description => @request_filter.filter_label,
              :order_description => @request_filter.order_label) %>
      <% elsif @request_filter.filter.present? %>
        <%= _("<strong>{{filter_description}}</strong> sorted by <strong>" \
              "{{order_description}}</strong> <a href=\"{{reset_url}}\"" \
              " class=\"clear-icon\">clear</a>",
              :reset_url => alaveteli_pro_info_requests_path,
              :filter_description => @request_filter.filter_capital_label,
              :order_description => @request_filter.order_label) %>
      <% elsif @request_filter.order && @request_filter.order != @request_filter.default_order %>
        <%= _("Sorted by <strong>{{order_description}}</strong>" \
              " <a href=\"{{reset_url}}\" class=\"clear-icon\">clear</a>",
              :reset_url => alaveteli_pro_info_requests_path,
              :order_description => @request_filter.order_label) %>
      <% end %>
      </p>
    </div>
    <div class="requests__list">
      <% if attention_active %>
        <% if @request_summaries.empty? && !@request_filter.search.present? && %w[needs_attention routine_updates].include?(@request_filter.filter) %>
          <p class="attention-empty"><%= @request_filter.filter == 'needs_attention' ? _('Nothing needs your attention.') : _('No routine updates.') %></p>
        <% end %>
        <%= render partial: "incoming_attention/request_groups", locals: { summaries: @request_summaries, data: @attention_data, filter: @request_filter.filter } %>
      <% else %>
        <%= render @request_summaries.map(&:summarisable) %>
      <% end %>
      <%= will_paginate WillPaginate::Collection.new(@page, @per_page, (attention_active ? @request_summaries.total_entries : @request_summaries.count)) %>
    </div> <!-- .requests__list -->

  </div> <!-- .requests -->

</div>  <!-- .dashboard-right-column -->

<% @title = _('Reset your password') %>
<%= page_band %>
<%= form_tag password_changes_path, data: { turbo: false } do %>
  <p>
    <%= label_tag 'password_change_user_email', _('Email address'), class: 'form_label' %>
    <%= email_field_tag 'password_change_user[email]', nil, required: true, autocomplete: 'email' %>
  </p>
  <div class="form_button">
    <%= submit_tag _('Send reset instructions') %>
  </div>
<% end %>

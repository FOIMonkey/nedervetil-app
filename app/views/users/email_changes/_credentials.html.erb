<p>
  <%= label_tag 'signchangeemail_password', _('Current password'), class: 'form_label' %>
  <%= password_field_tag 'signchangeemail[password]', nil, required: true, autocomplete: 'current-password' %>
</p>
<% if current_user.otp_required_for_login %>
  <p>
    <%= label_tag 'signchangeemail_otp_attempt', _('Authenticator code or recovery code'), class: 'form_label' %>
    <%= text_field_tag 'signchangeemail[otp_attempt]', nil, required: true, autocomplete: 'one-time-code' %>
  </p>
<% end %>

<% @title = _('Email Alerts Disabled') %>
<%= page_band %>

<p>
  <%= _('Email alerts for things you follow have now been disabled.') %>
</p>

<% if current_user %>
  <p>
    <%= _('<a href="{{inbox_link}}">Visit your requests</a> to get updates on ' \
          'things you follow or re-enable email alerts.',
          inbox_link: alaveteli_pro_info_requests_path) %>
  </p>
<% else %>
  <p>
    <%= _('<a href="{{sign_in_link}}">Sign in</a> to get updates on things ' \
          'you follow or re-enable email alerts.',
          sign_in_link: signin_path) %>
  </p>
<% end %>

<p>
  <%= _('Note that we may still send you emails when new correspondence ' \
        'appears on your requests, or when you perform actions that require ' \
        'an email confirmation step.') %>
</p>

<% request = @info_request %>
<% body = request.public_body %>
<% fmt = ->(date) { Deadlines::Overview.format_date(date) } %>
<% regime = Deadlines.regime(request) %>
<% kind = @internal_review ? (Deadlines.scottish?(regime) ? :scottish : :review) : :reply %>
<% action = Deadlines::NextAction.for(request) %>
<% latest = Deadlines::Reply.latest(request, current_ability) %>
<% answered = Deadlines::Stage.decision_response(request) || latest&.event %>
<% ask_by = if action.kind == :ask_review then action.date
            elsif action.review_by then action.review_by
            elsif latest&.review_open? then latest.review_by
            end %>
<% posted = @followup_letter %>
<% greeting, signoff = Deadlines::FollowupLetter.frame(request, @incoming_message, @internal_review) %>
<% sent = Deadlines::Stage.response_basis(request) %>
<% @title = { reply: _('Reply to {{authority}}', authority: body.name), review: _('Internal review'), scottish: _('Review') }.fetch(kind) %>
<% content_for :body_class, 'band-view requester-view followup-view' %>

<header class="page-band request-band">
  <% if kind != :reply %><p class="request-band__crumb"><%= link_to request.title, request_path(request) %></p><% end %>
  <h1 class="page-band__title request-band__title"><%= kind == :reply ? request.title : @title %></h1>
  <p class="request-band__facts">
    <span><%= _('To {{authority}}', authority: body.name) %></span>
    <% if kind == :reply %>
      <% if sent %><span><%= _('Sent {{date}}', date: fmt.(sent.created_at.to_date)) %></span><% end %>
    <% elsif answered %>
      <span><%= _('Their answer {{date}}', date: fmt.(answered.created_at.to_date)) %></span>
    <% end %>
    <span class="page-band__label"><%= _('Private') %></span>
  </p>
</header>
<%= band_notice %>

<div class="followup-page" id="followup">
  <%= foi_error_messages_for :outgoing_message %>
  <% if request.allow_new_responses_from == 'nobody' %>
    <p><%= _('New messages on this request have been stopped. {{contact_link}} if you need to send one.', contact_link: link_to(_('Contact us'), help_contact_path)) %></p>
  <% else %>
    <%# data-turbo="false": the next step renders a page after the submit, which Turbo would drop (doc/FORK.md). %>
    <%= form_tag request_followups_path(request_url_title: request.url_title, incoming_message_id: @incoming_message&.id),
                 class: "followup-form followup-form--#{kind}", data: { turbo: false, controller: ('review-letter' if kind == :scottish), action: ('change->review-letter#reason' if kind == :scottish) } do %>
      <%= hidden_field_tag :submitted_followup, 1, id: nil %>
      <% if @internal_review %>
        <%= hidden_field_tag :internal_review, 1, id: nil %>
      <% else %>
        <%= hidden_field_tag 'outgoing_message[what_doing]', 'normal_sort', id: nil %>
      <% end %>

      <% if kind == :reply %>
        <section class="request-flow" aria-labelledby="followup-title">
          <h2 id="followup-title"><%= _('Reply to {{authority}}', authority: body.name) %></h2>
          <% if @incoming_message&.followup_to_sender? %>
            <p class="followup-to"><%= _('To the officer who wrote. Or send it to {{link}}.', link: link_to(_('their main FOI address'), new_request_followup_path(request.url_title))) %></p>
          <% else %>
            <p class="followup-to"><%= _('To their main FOI address.') %></p>
          <% end %>
          <% if (event = @incoming_message&.response_event) && (said = Deadlines::Reply.new(request, event, current_ability).excerpt) %>
            <blockquote class="receipt__said"><p>“<%= said %>”</p><footer><%= _('Their letter, {{date}}', date: fmt.((@incoming_message.sent_at || @incoming_message.created_at).to_date)) %></footer></blockquote>
          <% end %>
          <div class="request-sheet">
            <div class="request-sheet__letter">
              <%= render partial: 'general/letter_sheet',
                         locals: { greeting: greeting, label: _('Your reply'), text: posted, rows: 8,
                                   signoff: signoff, signer: @user.name } %>
            </div>
          </div>
          <p class="followup-note"><%= _('If they asked you something, their 20 working days start again when you reply.') %></p>
          <div class="followup-actions">
            <button type="submit" class="button"><%= _('Send reply') %></button>
            <%= link_to _('Cancel'), request_path(request) %>
          </div>
        </section>
      <% else %>
        <div class="request-flow request-flow--two">
          <div class="request-flow__main">
            <% if kind == :review %>
              <p class="request-flow__quiet"><%= _('They look at their answer again. They should reply within {{days}} working days.', days: Deadlines.review_days.fetch(regime, 20)) %></p>
              <div class="request-sheet">
                <div class="request-sheet__letter">
                  <%= render partial: 'general/letter_sheet',
                             locals: { greeting: greeting, label: _('Your review letter'),
                                       text: posted || Deadlines::FollowupLetter.review(request, answered&.created_at),
                                       rows: 10, signoff: signoff, signer: @user.name } %>
                </div>
              </div>
            <% else %>
              <% chosen = params[:review_reason].to_s %>
              <fieldset class="followup-choices">
                <legend><%= _('What’s wrong with their answer?') %></legend>
                <% Deadlines::FollowupLetter::REASONS.each do |key, (label, sentence)| %>
                  <label class="followup-choice">
                    <%= radio_button_tag :review_reason, key, chosen == key, data: { sentence: (_(sentence) if sentence).to_s } %> <%= _(label) %>
                  </label>
                <% end %>
              </fieldset>
              <div class="followup-more">
                <label for="review_more"><%= _('Anything to add?') %></label>
                <%= text_area_tag :review_more, params[:review_more], rows: 3, data: { review_letter_target: 'input', action: 'review-letter#copy' }, placeholder: _('They sent 2024 but not 2025') %>
              </div>
              <% sentence = Deadlines::FollowupLetter::REASONS.dig(chosen, 1) %>
              <div class="request-sheet followup-letter" aria-label="<%= _('Your review letter') %>">
                <div class="request-sheet__letter">
                  <p class="request-sheet__fixed"><%= greeting %></p>
                  <p><%= Deadlines::FollowupLetter.scottish_opening(request) %></p>
                  <p><span data-review-letter-target="sentence" class="<%= 'followup-letter__gap' unless sentence %>"><%= sentence ? _(sentence) : _('Your reason, from your choice above.') %></span></p>
                  <p data-review-letter-target="more"><%= params[:review_more] %></p>
                  <p class="request-sheet__fixed"><%= signoff %><br><b><%= @user.name %></b></p>
                </div>
              </div>
            <% end %>
          </div>
          <aside class="request-flow__side request-flow__check">
            <ul class="flow-facts">
              <% if kind == :review %>
                <li><span class="flow-facts__value"><%= _('The standard letter') %></span><span class="flow-facts__note"><%= _('It’s all a review needs. Nothing to write.') %></span></li>
                <% if ask_by %><li><span class="flow-facts__value"><%= _('Ask by <b>{{date}}</b>', date: fmt.(ask_by)) %></span><span class="flow-facts__note"><%= regime == 'foi' ? _('After that, they can refuse to review it.') : _('40 working days after their reply.') %></span></li><% end %>
                <li><span class="flow-facts__value"><%= _('Worth asking') %></span><span class="flow-facts__note"><%= _('About 2 in 5 reviews release something.') %></span></li>
              <% else %>
                <li><span class="flow-facts__value"><%= _('One question') %></span><span class="flow-facts__note"><%= _('In Scotland, a review has to say what’s wrong. We fill in the rest.') %></span></li>
                <% if ask_by %><li><span class="flow-facts__value"><%= _('Ask by <b>{{date}}</b>', date: fmt.(ask_by)) %></span><span class="flow-facts__note"><%= _('40 working days, by law.') %></span></li><% end %>
                <li><span class="flow-facts__value"><%= _('Reply due <b>{{date}}</b>', date: fmt.(Deadlines::Calendar.working_days_after(Time.zone.today, Deadlines.review_days.fetch(regime, 20), regime))) %></span><span class="flow-facts__note"><%= _('20 working days, by law.') %></span></li>
              <% end %>
            </ul>
            <div class="followup-actions">
              <button type="submit" class="button"><%= _('Ask for review') %></button>
              <%= link_to _('Cancel'), request_path(request) %>
            </div>
          </aside>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>

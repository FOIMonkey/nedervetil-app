<% @title = 'Two factor authentication' %>

<div class="row">
  <div class="span12">
    <h1><%= @title %></h1>
    <p>Authenticator enrolment across accounts. Admins must enrol before they can sign in.</p>
  </div>
</div>

<div class="row">
  <div class="span8">
    <table class="table table-condensed">
      <thead>
        <tr>
          <th>Mode</th>
          <th class="text-right">All users</th>
          <th class="text-right">Admins</th>
        </tr>
      </thead>
      <tbody>
        <% [[:none, 'Not enrolled'], [:totp, 'Authenticator enabled']].each do |key, label| %>
          <tr>
            <td><%= label %></td>
            <td class="text-right"><%= number_with_delimiter(@all_counts[key]) %></td>
            <td class="text-right"><%= number_with_delimiter(@admin_counts[key]) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <th>Total</th>
          <th class="text-right"><%= number_with_delimiter(@all_counts[:total]) %></th>
          <th class="text-right"><%= number_with_delimiter(@admin_counts[:total]) %></th>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

<% if @unenrolled_admins.any? %>
  <div class="row">
    <div class="span12">
      <h2>Admins awaiting enrolment</h2>
      <p>These accounts cannot enter the admin interface until enrolment is complete.</p>

      <table class="table table-striped table-condensed">
        <thead>
          <tr>
            <th>Name</th>
            <th>Last sign-in</th>
          </tr>
        </thead>
        <tbody>
          <% @unenrolled_admins.each do |user| %>
            <tr>
              <td><%= link_to user.name, admin_user_path(user) %></td>
              <td>
                <% if user.last_sign_in_at %>
                  <%= time_ago_in_words(user.last_sign_in_at) %> ago
                <% else %>
                  <span class="muted">never</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>

<%= form_tag({}, method: :get, class: 'admin-search-bar') do %>
  <label for="query" class="visually-hidden">Search tags</label>
  <%= search_field_tag :query, params[:query], id: 'query', placeholder: 'Substring search for name, name:value or :value' %>
  <%= hidden_field_tag :model_type, params[:model_type] %>
  <%= submit_tag 'Search tags', class: 'btn btn-primary', name: nil %>
  <% if params[:query].present? %>
    <%= link_to 'Show all', url_for(model_type: params[:model_type]), class: 'btn' %>
  <% end %>
<% end %>

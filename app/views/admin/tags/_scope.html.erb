<ul class="nav nav-tabs">
  <% Taggable.models.sort_by(&:admin_title).each do |klass| %>
    <li class="<%= 'active' if current_klass == klass %>">
      <%= link_to klass.admin_title.gsub(/([a-z])([A-Z])/, '\1 \2').pluralize,
                  url_for(model_type: klass.name, query: params[:query]) %>
    </li>
  <% end %>
</ul>

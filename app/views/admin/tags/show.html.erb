<div class="admin-list-head">
  <h1><%= @title = "Tag – #{@tag}" %></h1>
  <div class="admin-summary__tools">
    <%= link_to 'All tags', admin_tags_path(model_type: current_klass), class: 'btn btn-small' %>
    <% if @value %>
      <%= link_to @name, admin_tag_path(tag: @name, model_type: current_klass), class: 'btn btn-small' %>
    <% end %>
    <% if current_klass == PublicBody %>
      <%= link_to 'Public page', list_public_bodies_by_tag_path(@tag), class: 'btn btn-small' %>
    <% end %>
  </div>
</div>

<%= render partial: 'notes', locals: { notes: @notes } %>

<h2>Taggings</h2>

<%= render partial: 'scope' %>
<%= render partial: 'filters' %>

<% if @taggings.empty? %>
  <p class="muted">No taggings.</p>
<% else %>
  <div class="admin-record-list">
    <%= render partial: 'tagging', collection: @taggings %>
  </div>
<% end %>

<%= will_paginate(@taggings) %>

<div class="admin-list-head">
  <h1><%= @title = "#{current_klass.admin_title} tags" %></h1>
</div>

<%= render partial: 'scope' %>
<%= render partial: 'filters' %>

<% if @tags.empty? %>
  <p class="muted">No tags.</p>
<% else %>
  <ul class="admin-tag-cloud">
    <% @tags.each do |record_tag| %>
      <li><%= render_tag(record_tag) %></li>
    <% end %>
  </ul>
<% end %>

<%= will_paginate(@tags) %>

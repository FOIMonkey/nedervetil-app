<div class="row">
  <div class="span12">
    <div class="alert alert-info alert-dismissible" data-controller="announcement-dismiss">
      <%= button_to announcement_path(announcement), method: :delete, class: 'close', form_class: 'alert-dismiss', form: { data: { action: 'announcement-dismiss#dismiss' } }, aria: { label: 'Close' } do %>
        <span aria-hidden="true">&times;</span>
      <% end %>
      <% if announcement.title.present? %><strong><%= announcement.title %> - </strong><% end %>
      <%= sanitize_without_style_blocks(announcement.content) %>
    </div>
  </div>
</div>

<% @title = 'Edit censor rule' %>

<div class="row">
  <div class="span12">
    <div class="page-header">
      <h1><%= @title %></h1>
    </div>
  </div>
</div>

<%= form_tag admin_censor_rule_path(@censor_rule), method: :put, class: 'form form-horizontal' do %>
  <%= render partial: 'form' %>

  <p>Applied to the published documents and the files in threads it reaches, since it was last saved: <strong><%= censor_rule_applied(@censor_rule) %></strong>.</p>

  <div class="form-actions">
    <%= submit_tag 'Save', accesskey: 's', class: 'btn btn-success' %>

    <%= link_to 'Destroy censor rule', admin_censor_rule_path(@censor_rule),
                method: :delete,
                accesskey: 'd',
                class: 'btn btn-danger',
                data: { confirm: 'Destroying a censor rule is permanent. ' \
                                 'Are you sure?' } %>
  </div>
<% end %>

<p class="admin-note">Regular expressions that are hard to match slow down every page the rule covers. Use one only when plain text won’t do.</p>

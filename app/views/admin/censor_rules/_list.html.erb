<% redaction_tracking = redaction_tracking?(local_assigns[:info_request]) %>
<% redaction_counts = censor_rule_redaction_counts(censor_rules, local_assigns[:info_request]) %>
<% columns = CensorRule.content_columns_names - %w[masking_finished_at] %>

<div class="row">
  <div class="span12 help-block">
    <p>
      Rules in the same pass match against the original text, with overlapping
      matches merged (using the longest match’s replacement) so shorter rules
      do not break longer phrases or redact another rule’s replacement text.
      Black rules apply on arrival before later Blue rules.
    </p>
  </div>
</div>

<div class="row">
  <% if censor_rules.size > 0 %>
    <table class="table table-condensed table-hover span12 censor-rule-list">
      <tr>
        <th>Id</th>
        <% columns.each do |column| %>
          <th><%= column.humanize %></th>
        <% end %>
        <th>Applied everywhere it reaches</th>
        <% if redaction_tracking %>
          <th>Records redacted</th>
        <% end %>
        <th>Actions</th>
      </tr>

      <% censor_rules.each do |censor_rule| %>
        <tr class="<%= cycle('odd', 'even') %>">
          <td class="id"><%=h censor_rule.id %></td>

          <% columns.each do |column| %>
            <% if column == 'censorable_type' %>
              <td class="applies-to">
                <%=h censor_rule.send(column) || 'Global' %>
              </td>
            <% else %>
              <td class="<%= column %>"><%=h censor_rule.send(column) %></td>
            <% end %>
          <% end %>

          <td class="applied"><%= censor_rule_applied(censor_rule) %></td>

          <% if redaction_tracking %>
            <td>
              <% count = redaction_counts.fetch(censor_rule.id, 0) %>

              <% if count.zero? %>
                <span class="badge"><%= count %></span>
              <% else %>
                <%= link_to admin_request_censor_rule_redactions_path(info_request, censor_rule) do %>
                  <span class="badge badge-warning">
                    <%= count %>
                  </span>
                <% end %>
              <% end %>
            </td>
          <% end %>

          <td>
            <%= link_to "Edit", edit_admin_censor_rule_path(censor_rule) %>
          </td>
        </tr>
      <% end %>
    </table>
  <% else %>
    <p class="span12">None yet.</p>
  <% end %>
</div>

<div class="row">
  <p class="span12">
    <% if defined? info_request %>
      <%= link_to "New censor rule", new_admin_request_censor_rule_path(info_request), :class => "btn btn-info" %>
      <span class="help-inline">for this request only</span>
    <% end %>

    <% if defined? user %>
      <%= link_to "New censor rule", new_admin_user_censor_rule_path(user), :class => "btn btn-info" %>
      <span class="help-inline">for all requests by this user</span>
    <% end %>

    <% if defined? public_body %>
      <%= link_to "New censor rule", new_admin_body_censor_rule_path(public_body), :class => "btn btn-info" %>
      <span class="help-inline">for all requests to this body</span>
    <% end %>

    <% unless defined?(info_request) || defined?(user) || defined?(public_body) %>
      <%= link_to "New global censor rule", new_admin_censor_rule_path, :class => "btn btn-warning" %>
      <span class="help-inline">for all requests, users and bodies</span>
    <% end %>
  </p>
</div>

<h1><%= @title %></h1>

<div class="btn-toolbar">
  <%= link_to 'Import releases', new_admin_external_release_import_path, class: 'btn btn-primary' %>
  <%= link_to 'External releases', admin_external_releases_path, class: 'btn' %>
</div>

<% if @imports.empty? %>
  <p>No imports yet.</p>
<% else %>
  <table class="table table-condensed">
    <thead><tr><th>When</th><th>File</th><th>By</th><th>New</th><th>Updated</th><th>Skipped</th><th></th></tr></thead>
    <tbody>
      <% @imports.each do |import| %>
        <tr>
          <td><%= link_to import.created_at.to_fs(:short), admin_external_release_import_path(import) %></td>
          <td><%= import.filename %></td>
          <td><%= import.user&.name %></td>
          <% if import.applied? %>
            <td><%= import.added_count %></td><td><%= import.updated_count %></td><td><%= import.skipped_count %></td><td></td>
          <% else %>
            <td colspan="3"></td><td><span class="label">Not imported</span></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= will_paginate(@imports) %>
<% end %>

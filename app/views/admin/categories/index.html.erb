<% @title = "Listing #{current_klass.admin_title} categories" %>

<h1><%= @title %></h1>

<%= render partial: 'scope' %>

<div class="btn-toolbar">
  <%= link_to 'New category', new_admin_category_path(model_type: current_klass), class: 'btn btn-primary' %>
</div>

<h2>All categories</h2>
<div>
  <div class="admin-record-list" id="category_list">
    <% @root.tree.each do |heading| %>
      <div class="admin-category-group" data-id="categories_<%= heading.id %>">
        <div class="admin-category-group__bar">
          <i class="icon-move category-drag-handle category-heading-handle" title="Drag to move" aria-hidden="true"></i>
          <details class="admin-category-group__details">
            <summary class="item-title accordion-heading">
              <span class="badge"><%= heading.children.size %></span>
              <strong><%= link_to(heading.title, edit_admin_category_path(heading, model_type: current_klass), title: 'view full details') %></strong>
            </summary>

            <div id="heading_<%= heading.id %>_categories" class="admin-category-group__body">
              <div class="well">
                <div id="heading_<%= heading.id %>_category_list" class="category-list">
                  <% heading.children.each do |category| %>
                    <div class="category-list-item" data-id="categories_<%= category.id %>">
                      <i class="icon-move category-drag-handle category-item-handle" title="Drag to move" aria-hidden="true"></i>
                      <%= link_to(category.title, edit_admin_category_path(category, model_type: current_klass), title: 'view full details') %>
                    </div>
                  <% end %>
                </div>

                <div class="form-actions save-panel" data-controller="category-order" data-category-order-list-value="heading_<%= heading.id %>_category_list" data-category-order-url-value="<%= reorder_admin_category_path(heading) %>" data-category-order-handle-value=".category-item-handle">
                  <%= link_to 'Save', '#', class: 'btn btn-success disabled save-order', aria: { disabled: true }, data: { category_order_target: 'save', action: 'category-order#save' } %><p class="save-notice" role="status" data-category-order-target="notice" data-unsaved-text="There are unsaved changes to the order of categories." data-success-text="Changes saved." data-error-text="There was an error saving your changes: ">Drag and drop to change the order of categories.</p>
                </div>
              </div>
            </div>
          </details>
        </div>
      </div>
    <% end %>
  </div>

  <div class="form-actions save-panel" data-controller="category-order" data-category-order-list-value="category_list" data-category-order-url-value="<%= reorder_admin_category_path(@root) %>" data-category-order-handle-value=".category-heading-handle">
    <%= link_to 'Save', '#', class: 'btn btn-success disabled save-order', aria: { disabled: true }, data: { category_order_target: 'save', action: 'category-order#save' } %><p class="save-notice" role="status" data-category-order-target="notice" data-unsaved-text="There are unsaved changes to the order of category headings." data-success-text="Changes saved." data-error-text="There was an error saving your changes: ">Drag and drop to change the order of category headings.</p>
  </div>
</div>

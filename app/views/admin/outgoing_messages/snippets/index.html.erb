<div class="admin-list-head">
  <h1><%= @title %></h1>
  <div class="admin-summary__tools">
    <%= link_to 'New snippet', new_admin_snippet_path, class: 'btn btn-small btn-primary' %>
    <%= link_to 'View tags', admin_tags_path(model_type: OutgoingMessage::Snippet), class: 'btn btn-small' %>
  </div>
</div>

<% if @snippets.empty? %>
  <p class="muted">No snippets found.</p>
<% else %>
  <div class="accordion" id="snippets">
    <%= render partial: 'admin/outgoing_messages/snippets/snippet',
               collection: @snippets %>
    <%= will_paginate(@snippets) %>
  </div>
<% end %>

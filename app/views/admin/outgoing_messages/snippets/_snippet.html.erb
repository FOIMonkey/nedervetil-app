<details class="admin-row-details">
  <summary class="admin-row-details__summary">
    <span class="item-title">
      <%= link_to snippet.name, edit_admin_snippet_path(snippet) %>
    </span>
    <span class="item-metadata">
      <%= render_tags snippet.tags %>
    </span>
  </summary>

  <div id="snippet_<%= snippet.id %>" class="item-detail">
    <% snippet.for_admin_column do |name, value| %>
      <div>
        <span><b><%= name.humanize %></b></span>
        <span><%= admin_value(value) %></span>
      </div>
    <% end %>
  </div>
</details>

<% @title = "Public authority – #{ @public_body.name }" %>

<%= render partial: 'admin/public_bodies/summary' %>

<details class="admin-all">
<summary>All fields</summary>
<table class="table table-striped table-condensed">
  <tbody>
    <% @public_body.for_admin_column do |name, value| %>
      <tr>
        <td>
          <b><%= name.humanize %></b>
        </td>

        <td>
          <% if ['home_page', 'publication_scheme', 'disclosure_log'].include? name %>
            <% if (url = HttpUrl.with_default_scheme(value)) %>
              <%= link_to h(value), url %>
            <% elsif value %>
              <%= value %>
            <% end %>
          <% elsif name == 'request_email' %>
            <% value = @public_body.read_attribute(:request_email) %>
            <%= link_to(h(value), "mailto:#{value}")  %>
            <%= render 'request_email_redirect' %>
            <% unless @public_body.is_requestable? %>
              <%= "not requestable due to: #{ @public_body.not_requestable_reason }" %><% if @public_body.is_followupable? %>; but followupable<% end %>
            <% end %>
          <% elsif name == 'notes' %>
            <%=h @public_body.legacy_note&.body %>
          <% else %>
            <%=h value %>
          <% end %>
        </td>
      </tr>
    <% end %>

    <tr>
      <td>
        <b>Calculated home page</b>
      </td>

      <td>
        <% unless @public_body.calculated_home_page.nil? %>
          <%= link_to(h(@public_body.calculated_home_page), @public_body.calculated_home_page) %>
        <% else %>
          *unknown*
        <% end %>
      </td>
    </tr>

    <tr>
      <td>
        <b>Tags</b>
      </td>

      <td>
        <%= render_tags @public_body.tags %>
      </td>
    </tr>
  </tbody>
</table>
</details>

<h2>History</h2>

<%= render partial: 'edit_history', locals: {versions: @public_body.versions.order(version: :desc)} %>

<hr>

<h2 id="body-requests">Requests</h2>

<%= render :partial => 'admin/requests/some_requests', :locals => { :info_requests => @info_requests } %>

<hr>


<h2>Censor rules</h2>

<%= render partial: 'admin/censor_rules/list',
           locals: { censor_rules: @public_body.censor_rules,
                     public_body: @public_body } %>

<hr>

<h2>Notes</h2>

<%= render partial: 'admin/notes/show',
  locals: { notes: @public_body.all_notes,
            notable: @public_body } %>

<div class="admin-triage__head">
  <span class="label label-important"><%= InfoRequest::State.short_description(info_request.calculate_status) %></span>
  <span class="muted">#<%= info_request.id %> · <%= admin_date(info_request.last_event_time) %></span>
</div>

<h2 class="admin-triage__title">
  <%= link_to info_request.title, admin_request_path(info_request), data: { turbo_frame: '_top' } %>
</h2>

<p class="muted">
  <%= link_to info_request.user.name, admin_user_path(info_request.user), data: { turbo_frame: '_top' } %>
  to <%= link_to info_request.public_body.name, admin_body_path(info_request.public_body), data: { turbo_frame: '_top' } %>
</p>

<% if info_request.reported? %>
  <% report = info_request.last_report_event %>
  <% blocker = info_request.report_reversion_blocker %>
  <div class="alert alert-warning">
    <% if report %>
      <% details = report.params || {} %>
      <p>
        <strong>Reported <%= admin_date(report.created_at) %></strong>
        <% if details[:reason].present? %> · <%= details[:reason] %><% end %>
      </p>
      <% if details[:message].present? %>
        <blockquote class="admin-report-message"><%= simple_format(h(details[:message].to_s)) %></blockquote>
      <% end %>
    <% end %>
    <% if blocker %>
      <p class="muted"><%= blocker.message %></p>
    <% elsif report %>
      <%= form_tag revert_report_admin_request_path(info_request),
                   class: 'admin-inline-form',
                   data: { turbo_frame: '_top' } do %>
        <%= hidden_field_tag :report_event_id, report.id %>
        <%= hidden_field_tag :return_to, admin_general_index_path %>
        <%= submit_tag 'Revert report', class: 'btn btn-small btn-primary' %>
      <% end %>
      <span class="muted">Restores <%= InfoRequest::State.short_description(info_request.classification_before_report) %></span>
    <% end %>
  </div>
<% elsif info_request.last_event&.params.present? %>
  <div class="alert">
    <% if info_request.last_event.params[:reason].present? %>
      <p><strong>Reason:</strong> <%= info_request.last_event.params[:reason] %></p>
    <% end %>
    <% if info_request.last_event.params[:message].present? %>
      <p><%= info_request.last_event.params[:message] %></p>
    <% end %>
  </div>
<% end %>

<%= render partial: 'admin/requests/prominence_control',
           locals: { info_request: info_request,
                     return_to: admin_general_index_path,
                     compact: true } %>

<div class="admin-triage__links">
  <%= link_to 'Open full request', admin_request_path(info_request), class: 'btn btn-primary', data: { turbo_frame: '_top' } %>
  <%= link_to 'Request page', show_request_path(info_request.url_title), class: 'btn', data: { turbo_frame: '_top' } %>
  <%= link_to 'Censor rule', new_admin_request_censor_rule_path(info_request), class: 'btn', data: { turbo_frame: '_top' } %>
</div>

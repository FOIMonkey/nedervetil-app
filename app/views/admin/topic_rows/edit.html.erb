<% kind = topic_record_kind(@row.class) %>
<% section = topic_row_association(@row) %>

<div class="page-header admin-list-head">
  <div>
    <p class="admin-summary__back">
      <%= link_to "← #{@topic_page.title}", edit_admin_topic_page_path(@topic_page, anchor: section) %>
      <span aria-hidden="true">/</span>
      <span><%= kind.pluralize %></span>
    </p>
    <h1><%= @title = "Edit #{kind.downcase}" %></h1>
    <p class="admin-lede"><%= truncate(topic_record_label(@row), length: 100) %></p>
  </div>
</div>

<%= form_for [:admin, @topic_page, @row], html: { class: 'admin-topic-form' } do |f| %>
  <%= render partial: 'form', locals: { f: f } %>
  <div class="form-actions">
    <%= submit_tag 'Save', class: 'btn btn-primary' %>
    <%= link_to 'Back to the topic', edit_admin_topic_page_path(@topic_page, anchor: section), class: 'btn' %>
  </div>
<% end %>

<section class="admin-danger-zone admin-topic-form__danger">
  <h2>Danger zone</h2>
  <p class="muted">Deleting this <%= kind.downcase %> removes it from the live topic page at once.</p>
  <%= form_tag [:admin, @topic_page, @row], class: 'form form-inline', method: 'delete' do %>
    <%= submit_tag "Delete #{kind.downcase}", class: 'btn btn-danger', data: { confirm: "Delete this #{kind.downcase}? It goes from the site at once." } %>
  <% end %>
</section>

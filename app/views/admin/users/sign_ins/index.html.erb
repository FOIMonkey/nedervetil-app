<%= form_tag admin_sign_ins_path, method: :get, class: 'admin-search-bar' do %>
  <label for="query" class="visually-hidden">Search sign-ins</label>
  <%= search_field_tag 'query', params[:query], id: 'query', placeholder: 'Name, email, IP or user agent' %>
  <%= submit_tag 'Search', class: 'btn btn-primary', name: nil %>
  <% if params[:query].present? %>
    <%= link_to 'Show all', admin_sign_ins_path, class: 'btn' %>
  <% end %>
<% end %>

<%= render partial: 'admin/users/sign_in_table',
           locals: { sign_ins: @sign_ins } %>

<%= will_paginate(@sign_ins) %>

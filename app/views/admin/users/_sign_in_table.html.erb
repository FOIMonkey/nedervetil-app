<% total_count = local_assigns.fetch(:total_count, sign_ins.size) %>
<div id="sign-ins">
  <% unless User::SignIn.retain_signins? %>
    <div class="alert alert-block alert-disabled">
      <h4>Sign-in retention disabled</h4>
      Set <tt>USER_SIGN_IN_ACTIVITY_RETENTION_DAYS</tt> above <tt>0</tt> to record sign-ins.
    </div>
  <% end %>

  <% if sign_ins.any? %>
    <p class="help-block">
      Records IP, user agent, date, and other accounts seen on the same IP. Handle with care.<% if total_count > sign_ins.size %> Showing latest <%= sign_ins.size %> of <%= total_count %>.<% end %>
    </p>

    <details class="admin-drawer" id="sign-ins-accordion">
      <summary>Reveal sign-ins (<%= sign_ins.size %>)</summary>
      <div id="sign-ins-accordion-table" class="admin-drawer__body">
        <table class="table table-condensed table-striped">
          <thead>
            <tr>
              <th>User</th>
              <th>IP</th>
              <th>User Agent</th>
              <th>Date</th>
              <th>Other Users</th>
            </tr>
          </thead>
          <tbody>
            <% sign_ins.each do |sign_in| %>
              <tr class="<%= cycle('odd', 'even') %>">
                <td><%= user_both_links(sign_in.user) %></td>
                <td>
                  <tt><%= link_to sign_in.ip, admin_sign_ins_path(query: sign_in.ip) %></tt>
                </td>
                <td>
                  <% if sign_in.user_agent %>
                    <small><tt><%= sign_in.user_agent %></tt></small>
                  <% else %>
                    <em>Not recorded</em>
                  <% end %>
                </td>
                <td><%= admin_date(sign_in.created_at, ago_only: true) %></td>
                <td><strong><%= sign_in.other_users.size %></strong> others using this IP</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </details>
  <% elsif User::SignIn.retain_signins? %>
    <p class="muted">
      None within the retention period (<%= User::SignIn.retention_days %> days).
    </p>
  <% end %>
</div>

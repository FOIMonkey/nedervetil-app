<%= form_for @foi_attachment, url: admin_foi_attachment_masks_path(@foi_attachment), method: :post, class: 'form form-inline' do |f| %>
  <fieldset class="form-horizontal">
    <legend>Masking</legend>

    <div class="controls">
      <div class="help-block">
        <p>
          Masking is the application of Text Masks and Censor Rules. When an
          attachment is masked it means that the cached copy of the attachment
          has been created with all applicable redaction rules applied.
        </p>

        <p>
          Attachments are masked when first viewed by a user. Admins can force
          masking to happen from here.
        </p>
      </div>

      <% if (served, fault = @foi_attachment.masking_fault) %>
        <div class="alert alert-error" id="masking-fault">
          <p>
            <strong>Masking hit a fault</strong>, so
            <%= served == :previous_copy ? 'the previous masked copy is served' : 'the file is served as it came' %>
            to the requester. It can't be published.
          </p>
          <p><tt><%= fault %></tt></p>
          <% if !@foi_attachment.erased? && @foi_attachment.raw_email&.kept? && !@foi_attachment.raw_email_erased? %>
            <p>
              <%= link_to 'Download the original', download_unmasked_admin_foi_attachment_path(@foi_attachment), class: 'btn' %>
              <span class="muted">As it is in the email: download only, and open it in an isolated viewer.</span>
            </p>
          <% end %>
        </div>
      <% end %>

      <% if (unmasked = @foi_attachment.unmasked_parts).any? %>
        <div class="alert alert-warning" id="unmasked-parts">
          <p>
            <strong>Served with parts not masked.</strong> Masking couldn't
            reach these, so they went out as they came:
          </p>
          <ul>
            <% unmasked.each do |part| %>
              <li><%= part %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </fieldset>

  <div class="form-actions">
    <% done = @foi_attachment.masked? && !@foi_attachment.masking_failed? %>
    <%= f.submit 'Mask now', disabled: done, class: 'btn' %>

    <% if done %>
      <span class="help-inline">
        Already masked.
      </span>
    <% end %>
  </div>
<% end %>

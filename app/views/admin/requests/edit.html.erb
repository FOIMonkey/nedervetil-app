<% @title = "Edit request ##{@info_request.id}" %>

<div class="admin-list-head">
  <h1>Edit basic details of request</h1>
  <div class="admin-summary__tools">
    <%= link_to 'Back to request', admin_request_path(@info_request), class: 'btn btn-small' %>
    <%= link_to 'List all', admin_requests_path, class: 'btn btn-small' %>
  </div>
</div>

<%= foi_error_messages_for :info_request %>

<%= form_tag admin_request_path(@info_request), method: :put, class: 'admin-edit-form' do %>

  <div class="control-group">
    <label for="info_request_title"><strong>Title</strong></label>
    <%= text_field 'info_request', 'title', size: 50, class: 'span6' %>
    <span class="help-block muted">
      Warning: editing this will break URLs right now.
    </span>
  </div>

  <div class="control-group">
    <% if @info_request.reject_incoming_at_mta? %>
      <% new_response_options_disabled = true %>
      <div class="alert alert-warning" role="alert">
        Mail for this request is automatically being rejected at the mail server due to spam, so you can't
        change the values set for '<strong>Allow new responses</strong> from' and
        '<strong>Handle rejected responses</strong> with'.
      </div>
    <% else %>
      <% new_response_options_disabled = false %>
    <% end %>
    <div class="admin-edit-pair">
      <div>
        <label for="info_request_allow_new_responses_from">
          <strong>Allow new responses</strong> from
        </label>
        <%= select('info_request',
                   'allow_new_responses_from',
                   %w[anybody authority_only nobody],
                   {},
                   { disabled: new_response_options_disabled }) %>
      </div>
      <div>
        <label for="info_request_handle_rejected_responses">
          <strong>Handle rejected responses</strong> with
        </label>
        <%= select('info_request', 'handle_rejected_responses',
                   %w[bounce holding_pen blackhole],
                   {},
                   { disabled: new_response_options_disabled }) %>
      </div>
    </div>

    <span class="help-block muted">
      <code>authority_only</code> means email <code>From:</code> domain of authority request email or
      any domain that has previously sent a response; <code>nobody</code> also stops
      requester making followups; take care when using <code>blackhole</code> which just
      drops mail.
    </span>
  </div>

  <div class="control-group">
    <label for="info_request_prominence"><strong>Prominence</strong></label>
    <%= select('info_request', 'prominence', %w[requester_only hidden]) %>

    <span class="help-block muted">
      Requests are always private: <code>requester_only</code> means the requester and
      admins; <code>hidden</code> means admins only.
    </span>
  </div>

  <div class="control-group">
    <label for="info_request_prominence_reason"><strong>Reason for prominence</strong></label>
    <%= text_area 'info_request', 'prominence_reason', rows: 4, class: 'span6' %>

    <span class="help-block muted">
      This reason is shown in public. If left blank a generic reason of
      "<%= ProminenceHelper::Base.default_prominence_reason %>" will be shown.
    </span>
  </div>

  <div class="control-group">
    <div class="admin-edit-pair">
      <div>
        <label for="info_request_described_state"><strong>Described state</strong></label>
        <%= select('info_request', 'described_state', InfoRequest::State.all) %>
      </div>
      <div>
        <label for="info_request_awaiting_description"><strong>Awaiting description</strong></label>
        <%= select('info_request', 'awaiting_description', [['Yes – needs state updating', true], ['No – state is up to date', false]]) %>
      </div>
    </div>

    <span class="help-block muted">
      Don't forget to change 'Awaiting description' when you set described state.
    </span>
  </div>

  <div class="control-group">
    <label for="info_request_tag_string"><strong>Tags</strong> <span class="muted">(space separated, can use key:value)</span></label>
    <%= render 'admin/tag_field', object_name: 'info_request',
                                  model_type: 'InfoRequest',
                                  html: { size: 60 } %>
  </div>

  <div class="form-actions">
    <%= submit_tag 'Save changes', accesskey: 's', class: 'btn btn-success' %>
    <%= link_to 'Show', admin_request_path(@info_request), class: 'btn' %>
    <%= link_to 'List all', admin_requests_path, class: 'btn' %>
  </div>

  <p class="muted"><strong>Note:</strong> To edit the actual request body text, click edit
    next to the specific outgoing message.
  </p>

<% end %>

<section class="admin-danger-zone">
  <h2>Danger zone</h2>
  <%= form_tag admin_request_path(@info_request), method: :delete do %>
    <p>
      <strong>This is permanent and irreversible.</strong>
      Use it mainly if someone posts private information, e.g. made a Data Protection request. It
      destroys all responses and tracks as well.
    </p>
    <%= submit_tag 'Destroy request entirely', class: 'btn btn-danger', data: { confirm: 'Are you sure you want to destroy this request?' } %>
  <% end %>
</section>

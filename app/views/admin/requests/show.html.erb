<% @title = "FOI request – #{ @info_request.title }" %>
<% documents = Disclosures::Document.where(info_request_id: @info_request.id).includes(:foi_attachment).order(:created_at, :id) %>
<% by_attachment = documents.select(&:foi_attachment_id).index_by(&:foi_attachment_id) %>
<% suggestions = Disclosures::Suggestion.where(incoming_message_id: @info_request.incoming_messages.select(:id)).index_by(&:foi_attachment_id) %>
<% outgoing_messages = @info_request.outgoing_messages.to_a %>
<% incoming_messages = @info_request.incoming_messages.to_a %>
<% events = @info_request.info_request_events.to_a %>
<% thread_entries = (
     outgoing_messages.map { |m| { kind: 'outgoing', time: m.last_sent_at || m.created_at, order: 1, record: m } } +
     incoming_messages.map { |m| { kind: 'incoming', time: m.sent_at || m.created_at, order: 2, record: m } } +
     events.map { |e| { kind: 'event', time: e.created_at, order: 0, record: e } }
   ).sort_by { |entry| [entry[:time] || Time.at(0), entry[:order], entry[:record].id] } %>

<%= render partial: 'admin/requests/summary' %>

<div class="admin-summary">
  <section class="admin-block" id="request-thread" aria-labelledby="request-thread-heading" data-controller="thread-filter bulk-select">
    <h2 id="request-thread-heading">
      Correspondence and events
      <span class="admin-block__count">
        <%= pluralize(outgoing_messages.size, 'sent message') %>,
        <%= pluralize(incoming_messages.size, 'reply', plural: 'replies') %>,
        <%= pluralize(events.size, 'event') %>
      </span>
    </h2>

    <div class="admin-filter-pills" role="group" aria-label="Filter thread">
      <button type="button" class="admin-pill" aria-pressed="true" data-filter-mode="all" data-thread-filter-target="button" data-action="click->thread-filter#filter">All (<%= thread_entries.size %>)</button>
      <button type="button" class="admin-pill" aria-pressed="false" data-filter-mode="messages" data-thread-filter-target="button" data-action="click->thread-filter#filter">Messages (<%= outgoing_messages.size + incoming_messages.size %>)</button>
      <button type="button" class="admin-pill" aria-pressed="false" data-filter-mode="events" data-thread-filter-target="button" data-action="click->thread-filter#filter">Events (<%= events.size %>)</button>
    </div>

    <% if thread_entries.empty? %>
      <p class="admin-clear">No correspondence or events yet.</p>
    <% else %>
      <div class="admin-thread">
        <% thread_entries.each do |entry| %>
          <% case entry[:kind] %>
          <% when 'outgoing' %>
            <% outgoing_message = entry[:record] %>
            <article class="admin-thread__item admin-thread__item--outgoing" data-thread-kind="outgoing" data-thread-filter-target="item">
              <div class="admin-thread__head">
                <span class="label">Sent</span>
                <%= both_links(outgoing_message) %>
                <span class="muted">
                  <%= outgoing_message.status.humanize %> <%= outgoing_message.message_type.humanize %>
                  · <%= admin_date(outgoing_message.last_sent_at) %>
                </span>
              </div>
              <blockquote class="admin-thread__excerpt">
                <%= truncate(outgoing_message.body, length: 400) %>
              </blockquote>
              <details id="outgoing_<%= outgoing_message.id %>" class="admin-drawer admin-drawer--tight">
                <summary>Actions and fields</summary>
                <div class="admin-drawer__body">
                  <% if outgoing_message.from_name != @info_request.user_name %>
                    <div class="alert alert-error">
                      The requester's name has changed since this message was last sent to the authority.
                    </div>
                  <% end %>
                  <div class="well well-small">
                    <%= form_tag resend_admin_outgoing_message_path(outgoing_message), class: 'admin-table-form' do %>
                      <% msg = 'Are you sure you want to resend this message to the authority?' %>
                      <%= submit_tag 'Resend', class: 'btn btn-small btn-warning', data: { confirm: msg } %>
                    <% end %>
                  </div>
                  <%= render partial: 'admin/outgoing_messages/admin_columns',
                             locals: { outgoing_message: outgoing_message } %>
                </div>
              </details>
            </article>

          <% when 'incoming' %>
            <% incoming_message = entry[:record] %>
            <% files = incoming_message.get_attachments_for_display %>
            <article class="admin-thread__item admin-thread__item--incoming" data-thread-kind="incoming" data-thread-filter-target="item">
              <div class="admin-thread__head">
                <%= check_box_tag "message_id_#{incoming_message.id}", incoming_message.id, false,
                                  class: 'delete-checkbox',
                                  data: { bulk_select_target: 'checkbox', action: 'bulk-select#update' } %>
                <span class="label label-solid">Reply</span>
                <%= both_links(incoming_message) %>
                <span class="muted">
                  <%= h(incoming_message.from_name) %> · <%= admin_date(incoming_message.sent_at) %><% if files.any? %> · <%= pluralize(files.size, 'file') %><% end %>
                </span>
              </div>
              <% if !incoming_message.cached_main_body_text_folded.nil? %>
                <blockquote class="admin-thread__excerpt incoming-message">
                  <%= truncate(incoming_message.cached_main_body_text_folded.gsub('FOLDED_QUOTED_SECTION', ''), length: 400) %>
                </blockquote>
              <% end %>

              <% if files.any? %>
                <ul class="admin-files">
                  <% files.each do |attachment| %>
                    <% document = by_attachment[attachment.id] %>
                    <% suggestion = suggestions[attachment.id] %>
                    <% attribution = AttachmentManagement::Attribution.new(attachment).text.presence %>
                    <li>
                      <span><%= attachment.display_filename %></span>
                      <span class="admin-files__state">
                        <% if document %>
                          <span class="label<%= ' label-warning' if document.stage_in?(:held, :in_review, :not_ready, :ready) %>"><%= document_state(document) %></span>
                          <%= link_to document.title, disclosure_manage_document_path(document) %>
                        <% elsif suggestion&.set_aside? %>
                          <span class="muted">Set aside</span>
                        <% else %>
                          <span class="muted">Stays in the thread</span>
                        <% end %>
                        <% if attribution %><span class="muted"><%= attribution %></span><% end %>
                        <% if (served, = attachment.masking_fault) %>
                          <span class="label label-important">Masking fault</span>
                          <span class="muted"><%= served == :previous_copy ? 'previous masked copy served' : 'served as it came' %>; can't be published</span>
                        <% end %>
                        <% if (unmasked = attachment.unmasked_parts).any? %>
                          <span class="label label-warning">Parts not masked</span>
                          <span class="muted"><%= unmasked.join('; ') %></span>
                        <% end %>
                      </span>
                    </li>
                  <% end %>
                </ul>
              <% end %>

              <details id="incoming_<%= incoming_message.id %>" class="admin-drawer admin-drawer--tight">
                <summary>Actions and fields</summary>
                <div class="admin-drawer__body">
                  <div class="well well-small">
                    <%= render partial: 'admin/incoming_messages/actions',
                               locals: { incoming_message: incoming_message } %>
                  </div>
                  <%= render partial: 'admin/incoming_messages/admin_columns',
                             locals: { incoming_message: incoming_message } %>
                </div>
              </details>
            </article>

          <% when 'event' %>
            <% info_request_event = entry[:record] %>
            <div class="admin-thread__item admin-thread__item--event" data-thread-kind="event" data-thread-filter-target="item">
              <details id="event_<%= info_request_event.id %>" class="admin-drawer admin-drawer--event">
                <summary>
                  <span class="label">Event #<%= info_request_event.id %></span>
                  <strong>
                    <%= h info_request_event.event_type.humanize %><% if info_request_event.calculated_state.present? %> · <%= InfoRequest::State.short_description(info_request_event.calculated_state) %><% end %>
                  </strong>
                  <em class="muted"><%= admin_date(info_request_event.created_at) %></em>
                </summary>
                <div class="admin-drawer__body">
                  <% if info_request_event.described_state != 'waiting_clarification' && info_request_event.event_type == 'response' %>
                    <%= form_tag admin_info_request_event_path(info_request_event), method: 'put', class: 'admin-inline-form' do %>
                      <%= submit_tag 'Was clarification request', class: 'btn btn-mini btn-primary' %>
                    <% end %>
                  <% end %>
                  <table class="table table-striped table-condensed">
                    <tbody>
                      <% info_request_event.for_admin_column do |name, value| %>
                        <tr>
                          <td><b><%= name.humanize %></b></td>
                          <td>
                            <% if name == 'params' %>
                              <%= render partial: 'params', locals: { params: info_request_event.params_diff } %>
                            <% else %>
                              <%= admin_value(value) %>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              </details>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if incoming_messages.any? %>
      <div class="admin-bulk-bar">
        <%= form_tag bulk_destroy_admin_incoming_messages_path do %>
          <%= hidden_field_tag(:ids, nil, data: { bulk_select_target: 'ids' }) %>
          <%= hidden_field_tag(:request_id, @info_request.id) %>
          <%= submit_tag 'Destroy selected messages',
                         class: 'btn btn-small btn-danger',
                         disabled: true,
                         data: { bulk_select_target: 'submit' } %>
        <% end %>
      </div>
    <% end %>
  </section>

  <details id="metadata_<%= @info_request.id %>" class="admin-all">
    <summary>All fields</summary>
    <p><%= link_to 'Edit metadata', edit_admin_request_path(@info_request), class: 'btn btn-small' %></p>
    <table class="table table-striped table-condensed">
      <tbody>
        <tr>
          <th>Request page:</th>
          <td><%= link_to show_request_url(@info_request.url_title), show_request_path(@info_request.url_title) %></td>
        </tr>
        <% @info_request.for_admin_column do |name, value| %>
          <tr>
            <td><b><%= name.humanize %>:</b></td>
            <td>
              <% if name == 'prominence' %>
                <%= h highlight_prominence(value) %>
              <% elsif name == 'allow_new_responses_from' %>
                <%= h highlight_allow_new_responses_from(value) %>
              <% else %>
                <%= admin_value(value) %>
              <% end %>
              <% if name == 'described_state' %>
                <ul>
                  <li><strong>Request status:</strong> <%= @info_request.calculate_status %></li>
                  <li><strong>Date initial request last sent at:</strong> <%= @info_request.date_initial_request_last_sent_at %></li>
                  <li><strong>Date response required by:</strong> <%= @info_request.date_response_required_by %></li>
                  <li><strong>Very overdue after:</strong> <%= @info_request.date_very_overdue_after %></li>
                </ul>
              <% end %>
            </td>
          </tr>
        <% end %>
        <tr>
          <td><b>Created by</b></td>
          <td><%= both_links(@info_request.user) %></td>
        </tr>
        <tr>
          <td><b>Public authority:</b></td>
          <td><%= both_links(@info_request.public_body) %></td>
        </tr>
        <% if @info_request.info_request_batch %>
          <tr>
            <td><b>Info Request Batch:</b></td>
            <td><%= both_links(@info_request.info_request_batch) %></td>
          </tr>
        <% end %>
        <tr>
          <td><b>Incoming email address</b></td>
          <td><%= link_to h(@info_request.incoming_email), "mailto:#{@info_request.incoming_email}" %></td>
        </tr>
        <tr>
          <td><b>Tags</b></td>
          <td><%= render_tags @info_request.tags %></td>
        </tr>
      </tbody>
    </table>
  </details>

  <% mail_logs = @info_request.mail_server_logs.group_by(&:mail_server_log_done_id) %>
  <details class="admin-drawer">
    <summary>Mail server delivery logs <span class="admin-block__count">(<%= @info_request.mail_server_logs.size %>)</span></summary>
    <div class="admin-drawer__body">
      <p class="muted">Lines containing the request incoming email address, updated hourly.</p>
      <% if mail_logs.any? %>
        <% mail_logs.each_value do |logs| %>
          <pre><% logs.each do |log| %><%= h log.line %><% end %></pre>
        <% end %>
      <% else %>
        <p class="muted">None (perhaps this is an old or a very new request).</p>
      <% end %>
    </div>
  </details>

  <% censor_rules = @info_request.applicable_censor_rules %>
  <details class="admin-drawer"<%= ' open' if censor_rules.any? %>>
    <summary>Censor rules <span class="admin-block__count">(<%= censor_rules.size %>)</span></summary>
    <div class="admin-drawer__body">
      <%= render partial: 'admin/censor_rules/list',
                 locals: { censor_rules: censor_rules,
                           info_request: @info_request } %>
    </div>
  </details>

  <% notes = @info_request.all_notes %>
  <details class="admin-drawer"<%= ' open' if notes.any? %>>
    <summary>Notes <span class="admin-block__count">(<%= notes.size %>)</span></summary>
    <div class="admin-drawer__body">
      <%= render partial: 'admin/notes/show',
                 locals: { notes: notes,
                           notable: @info_request } %>
    </div>
  </details>
</div>

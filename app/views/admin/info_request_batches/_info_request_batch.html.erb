<details class="admin-row-details">
  <summary class="admin-row-details__summary">
    <span class="item-title">
      <%= both_links(info_request_batch) %>
    </span>
    <span class="item-metadata">
      <%= both_links(info_request_batch.user) %>
      <%= arrow_right %>
      <%= "to #{info_request_batch.public_bodies.size} authorities" %>,
      <%= admin_date(info_request_batch.updated_at, ago_only: true) %>
    </span>
  </summary>

  <div id="batch_<%= info_request_batch.id %>" class="item-detail">
    <% info_request_batch.for_admin_column do |name, value| %>
      <div>
        <span><%= name.humanize %></span>
        <span><%= admin_value(value) %></span>
      </div>
    <% end %>
  </div>
</details>

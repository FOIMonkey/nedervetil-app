<% if @link.errors.any? %>
  <div class="alert alert-error">
    <ul><% @link.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
  </div>
<% end %>

<%= form_with model: @link, scope: :link, url: url, method: method, class: 'form-horizontal' do |f| %>
  <div class="control-group">
    <%= f.label :label, 'Link text', class: 'control-label' %>
    <div class="controls"><%= f.text_field :label, class: 'span3', required: true, maxlength: 40 %>
      <p class="help-block">Four words or fewer.</p></div>
  </div>
  <div class="control-group">
    <%= f.label :url_template, 'Address', class: 'control-label' %>
    <div class="controls"><%= f.text_field :url_template, class: 'span6', required: true, placeholder: 'https://www.wikidata.org/wiki/{value}' %>
      <p class="help-block"><code>{value}</code> is the tag’s value; <code>{url_name}</code> is the authority’s URL name.</p></div>
  </div>
  <div class="control-group">
    <%= f.label :tag, class: 'control-label' %>
    <div class="controls"><%= f.text_field :tag, class: 'span2', placeholder: 'wikidata' %>
      <p class="help-block">Leave blank for every authority.</p></div>
  </div>
  <div class="control-group">
    <%= f.label :position, 'Order', class: 'control-label' %>
    <div class="controls"><%= f.number_field :position, class: 'span1' %></div>
  </div>
  <div class="form-actions">
    <%= f.submit 'Save link', class: 'btn btn-primary' %>
    <%= link_to 'Cancel', admin_authority_pages_path, class: 'btn' %>
  </div>
<% end %>

<div id="signup" class="signup">
  <%# data-turbo="false": the next step renders a page after the submit, which Turbo would drop (doc/FORK.md). %>
  <%= form_tag(signup_path, {:id => "signup_form", :data => { :turbo => false }}) do %>
    <%= foi_error_messages_for :user_signup %>

    <p>
      <label class="form_label" for="user_signup_name"> <%= _('Your name:') %></label>
      <%= text_field 'user_signup', 'name', { :size => 20, :autocomplete => 'name' } %>
    </p>

    <div class="form_item_note">
      <%= _('For your request to be valid, this should be your real name.') %>
    </div>

    <p>
      <label class="form_label" for="user_signup_email"><%= _('Your e-mail:') %></label>
      <%= text_field 'user_signup', 'email', { :size => 20, :autocomplete => 'email' } %>
    </p>

    <div class="form_item_note">
      <%= _('We will not reveal your email address to anybody unless ' \
            '<a href="{{url}}">you or the law tell us to</a>.',
            :url => help_privacy_path) %>
    </div>

    <%= turnstile_box('signup') %>

    <div class="form_button">
      <%= hidden_field_tag :modal, sign_page_params[:modal], id: 'signup_modal' %>
      <% if sign_page_params.key?(:r) %>
        <%= hidden_field_tag :r, sign_page_params[:r], id: 'signup_return' %>
      <% end %>

      <p>
        <%= submit_tag _('Sign up'),
                       :data => { :disable_with => _("Sending...") } %>
      </p>
    </div>
  <% end %>
</div>

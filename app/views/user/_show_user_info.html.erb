<% if @is_you && @display_user.active? %>
  <ul class="account-settings" id="user_change_password_email">
    <li>
      <span class="account-settings__name"><%= _('Name') %></span>
      <span class="account-settings__value"><%= @display_user.name %></span>
      <%= link_to _('Change'), edit_users_name_path, class: 'account-settings__change', 'aria-label': _('Change your name') %>
    </li>
    <li>
      <span class="account-settings__name"><%= _('Email') %></span>
      <span class="account-settings__value"><%= @display_user.email %></span>
      <%= link_to _('Change'), signchangeemail_path, class: 'account-settings__change', 'aria-label': _('Change your email') %>
    </li>
    <li>
      <span class="account-settings__name"><%= _('Password') %></span>
      <span class="account-settings__value"></span>
      <%= link_to _('Change'), new_password_change_path, class: 'account-settings__change', 'aria-label': _('Change your password') %>
    </li>
    <li>
      <span class="account-settings__name"><%= _('Automatic reading of replies') %></span>
      <span class="account-settings__value"><%= IncomingAttention::OptOut.opted_out?(@display_user) ? _('Off') : _('On') %></span>
      <%= link_to _('Change'), profile_ai_reading_path, class: 'account-settings__change', 'aria-label': _('Change automatic reading of replies') %>
    </li>
    <% if AlaveteliConfiguration.enable_two_factor_auth %>
      <li>
        <span class="account-settings__name"><%= _('Two-factor authentication') %></span>
        <span class="account-settings__value"><%= @display_user.otp_enabled? ? _('On') : _('Off') %></span>
        <%= link_to _('Change'), one_time_password_path, class: 'account-settings__change', 'aria-label': _('Change two-factor authentication') %>
      </li>
    <% end %>
  </ul>
<% end %>

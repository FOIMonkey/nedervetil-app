<% if @is_you && @display_user.active? %>
  <% @title = _('Account') %>
  <% content_for :body_class, 'band-view account-view' %>
  <header class="page-band account-band">
    <h1 class="page-band__title"><%= _('Account') %></h1>
    <p class="account-band__sub"><%= _('{{user_name}} · joined {{year}}', user_name: @display_user.name, year: @display_user.created_at.year) %></p>
  </header>
  <%= band_notice %>
  <div class="account-page">
    <%= render partial: 'user/show_user_info' %>
  </div>
<% else %>
  <% @title = _("{{user_name}} - user profile",
                :user_name => h(@display_user.name)) %>

  <%= render partial: 'user/show/show_profile' %>

  <% if @is_you %>
    <h2 id="email_subscriptions" class="email_subscriptions">
      <%= _('Email alerts') %>
    </h2>

    <%= render :partial => 'change_receive_email' %>
  <% end %>
<% end %>

<div id="signin" class="signin">
  <%# data-turbo="false": the next step renders a page after the submit, which Turbo would drop (doc/FORK.md). %>
  <%= form_tag(signin_path, {:id => "signin_form", :data => { :turbo => false }}) do %>
    <%= foi_error_messages_for :user_signin %>

    <p>
      <label class="form_label" for="user_signin_email"><%= _('Your e-mail:') %></label>
      <%= text_field 'user_signin', 'email', { :size => 20, :autocomplete => 'username' } %>
    </p>

    <p>
      <label class="form_label" for="user_signin_password"><%= _('Password:') %></label>
      <%= password_field 'user_signin', 'password', { :size => 15, :autocomplete => 'current-password' } %>
    </p>

    <p class="form_note">
      <%= link_to _('Forgotten your password?'), new_password_change_path %>
      <%= link_to _('Resend confirmation email'), new_user_confirmation_path %>
    </p>

    <p>
      <%= label_tag 'user_signin_otp_attempt', _('Authenticator code or recovery code (if enabled)') %>
      <%= text_field_tag 'user_signin[otp_attempt]', nil, autocomplete: 'one-time-code' %>
    </p>
    <p><%= _('For your privacy, sign in again after three hours of inactivity.') %></p>
    <div class="form_button">
      <%= hidden_field_tag :modal, sign_page_params[:modal], id: 'signin_modal' %>
      <% if sign_page_params.key?(:r) %>
        <%= hidden_field_tag :r, sign_page_params[:r], id: 'signin_return' %>
      <% end %>
      <%= submit_tag _('Sign in') %>
    </div>
  <% end %>
</div>

<% if use_rbenv? %>
PATH=/home/<%= user %>/.rbenv/shims:/usr/local/bin:/usr/bin:/bin
<% else %>
PATH=/home/<%= user %>/.gem/ruby/<%= ruby_version %>/bin:/usr/local/bin:/usr/bin:/bin
<% end %>

MAILTO=<%= mailto %>
RAILS_LOG_LEVEL=warn

# Every 5 minutes
3-58/5 * * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/incoming-attention-recover.lock "cd <%= vhost_dir %>/<%= vcspath %> && bin/rails --quiet incoming_attention:recover" || echo "stalled?"
# Every 10 minutes
0,10,20,30,40,50 * * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/send-batch-requests.lock <%= vhost_dir %>/<%= vcspath %>/script/send-batch-requests || echo "stalled?"

# Once an hour
31 * * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/load-mail-server-logs.lock <%= vhost_dir %>/<%= vcspath %>/script/load-mail-server-logs || echo "stalled?"
37 * * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/documents-clean-up.lock "cd <%= vhost_dir %>/<%= vcspath %> && bin/rails --quiet documents:clean_up" || echo "stalled?"

# Once a day, early morning
23 4 * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/delete-old-things.lock <%= vhost_dir %>/<%= vcspath %>/script/delete-old-things || echo "stalled?"
0 5 * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/update-overdue-info-request-events.lock <%= vhost_dir %>/<%= vcspath %>/script/update-overdue-info-request-events || echo "stalled?"
2 4 * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/check-recent-requests-sent.lock <%= vhost_dir %>/<%= vcspath %>/script/check-recent-requests-sent || echo "stalled?"
45 3 * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/stop-new-responses-on-old-requests.lock <%= vhost_dir %>/<%= vcspath %>/script/stop-new-responses-on-old-requests || echo "stalled?"
30 4 * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/storage-raw-emails.lock "cd <%= vhost_dir %>/<%= vcspath %> && bin/rails --quiet storage:raw_emails:mirror storage:raw_emails:promote storage:raw_emails:unlink" || echo "stalled?"
30 5 * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/storage-attachments.lock "cd <%= vhost_dir %>/<%= vcspath %> && bin/rails --quiet storage:attachments:mirror storage:attachments:promote storage:attachments:unlink" || echo "stalled?"
0 3 * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/storage-purge-unattached.lock "cd <%= vhost_dir %>/<%= vcspath %> && bin/rails --quiet storage:purge_unattached" || echo "stalled?"

# Once a day on all servers
40 2 * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/users-signins-purge.lock "cd <%= vhost_dir %>/<%= vcspath %> && bin/rails users:sign_ins:purge" || echo "stalled?"
53 2 * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/users-destroy-unused.lock "cd <%= vhost_dir %>/<%= vcspath %> && bin/rails --quiet users:destroy_unused" || echo "stalled?"
38 2 * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/public-body-export.lock "cd <%= vhost_dir %>/<%= vcspath %> && bin/rails public_body:export" || echo "stalled?"
42 4 * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/raw-emails-purge-expired.lock "cd <%= vhost_dir %>/<%= vcspath %> && bin/rails --quiet raw_emails:purge_expired" || echo "stalled?"
47 4 * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/documents-check-unread-spreadsheets.lock "cd <%= vhost_dir %>/<%= vcspath %> && bin/rails --quiet documents:check_unread_spreadsheets" || echo "stalled?"
41 5 * * * <%= user %> <%= vhost_dir %>/<%= vcspath %>/vendor/mysociety/bin/run-with-lockfile.sh -n <%= vhost_dir %>/authority-feeds-fetch.lock "cd <%= vhost_dir %>/<%= vcspath %> && timeout --kill-after=10s 20m bin/rails --quiet authority_feeds:fetch" || echo "stalled?"

# Once a week (very early Monday morning)
54 2 * * 1 <%= user %> <%= vhost_dir %>/<%= vcspath %>/script/cleanup-holding-pen

# Once a year :)
0 0 1 11 * <%= user %> <%= vhost_dir %>/<%= vcspath %>/script/send-public-holiday-reminder

#!/bin/sh

set -e

cd "$(dirname "$0")/.."

. docker/env

docker compose down

RESET_FLAG=""
DB_VOLUME="$(basename "$(pwd)")_postgres"
if docker volume ls | grep -q "$DB_VOLUME"; then
  while true
  do
    read -r -p 'Do you also want to reset your development database? ' choice
    case "$choice" in
      n|N) break;;
      y|Y)
        docker volume rm "$DB_VOLUME" >/dev/null
        RESET_FLAG="--reset-data"
        break;;
      *) echo 'Response not valid';;
    esac
  done
fi

docker compose build --pull

if [ -n "$RESET_FLAG" ]; then
  ./docker/setup "$RESET_FLAG"
else
  ./docker/setup
fi

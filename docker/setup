#!/bin/sh

set -e

cd "$(dirname "$0")/.."

if [ -z "$DOCKER" ]; then
  . docker/env
  ./docker/bootstrap
  docker compose run --rm app ./docker/setup "$@"
  exit
fi

error_msg() { printf "\033[31m%s\033[0m\n" "$*"; }
notice_msg() { printf "\033[33m%s\033[0m " "$*"; }
success_msg() { printf "\033[32m%s\033[0m\n" "$*"; }

notice_msg 'Installing Ruby gems...'
bundle check >/dev/null || bundle install
success_msg 'done'

if [ -L config/general.yml ]; then
  THEME=$(basename -s .yml "$(readlink config/general.yml)" | sed 's/^general-//')
  notice_msg "Switching to $THEME..."
  if output=$(bundle exec script/switch-theme.rb "$THEME" 2>&1); then
    bin/rails assets:clean >/dev/null
    success_msg 'done'
  else
    error_msg 'failed'
    printf '%s\n' "$output"
    exit 1
  fi
fi

# check to see if the database has ever been seeded, if not then set the
# RESET_DATA_FLAG regardless of arguments passed to the script. It asks what
# the sample data loader asks, so the two agree.
if bin/rails runner 'exit(SampleData.data? ? 0 : 1)' 2>/dev/null; then
  RESET_DATA_FLAG=0
else
  RESET_DATA_FLAG=1
fi
for arg in "$@"; do
  case $arg in
    --reset-data)
      RESET_DATA_FLAG=1
      shift
      ;;
    *);;
  esac
done

notice_msg 'Migrating development and test databases...'
if [ $RESET_DATA_FLAG -eq 1 ]; then
  ANNOTATERB_SKIP_ON_DB_TASKS=1 bin/rails db:migrate db:seed >/dev/null
  ANNOTATERB_SKIP_ON_DB_TASKS=1 bin/rails db:migrate RAILS_ENV=test >/dev/null
  success_msg 'done'
else
  error_msg 'skipped'
fi

notice_msg 'Loading sample data...'
if [ $RESET_DATA_FLAG -eq 1 ]; then
  if output=$(bin/rails sample_data:load 2>&1); then
    success_msg 'done'
  else
    error_msg 'failed'
    printf '%s\n' "$output"
    exit 1
  fi
else
  error_msg 'skipped'
fi


success_msg 'Setup finished'
echo 'Sign in with:'
bin/rails sample_data:accounts
echo
echo 'Start the app and background workers with: docker/server'
echo 'Or run them in the background with: docker/server -d'
echo 'App: http://localhost:3000 | Captured mail: http://localhost:1080'
